"use strict";
document.addEventListener("click", function(e) {
    var wall = document.querySelector(".wall");
    if (e.target === wall) {
        var spider = document.querySelector(".spider");
        var wallRect = wall.getBoundingClientRect();
        var spiderRect = spider.getBoundingClientRect();
        var borderLeft = wall.clientLeft;
        var borderTop = wall.clientTop;
        var left = e.clientX - wallRect.left - borderLeft - spiderRect.width / 2;
        var top = e.clientY - wallRect.top - borderTop - spiderRect.height / 2;
        var maxLeft = wall.clientWidth - spiderRect.width;
        var maxTop = wall.clientHeight - spiderRect.height;
        left = Math.max(0, Math.min(left, maxLeft));
        top = Math.max(0, Math.min(top, maxTop));
        spider.style.left = "".concat(left, "px");
        spider.style.top = "".concat(top, "px");
    }
});

